# Engineering Intelligence Hub — environment template
# Copy to `.env` and fill in the values. Never commit the real `.env`.

# --- Backend (Supabase Postgres + pgvector) ---
# Browser-visible client config
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<publishable-key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# Server-only config (never exposed to the browser)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<publishable-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# --- AI (embeddings + grounded answer generation) ---
# Used server-side only, for /v1/embeddings and /v1/chat/completions
AI_GATEWAY_API_KEY="<ai-gateway-key>"
